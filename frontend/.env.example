# Copy this file to frontend/.env for local development if needed.
# Vite only exposes variables prefixed with VITE_.

# Backend API base URL. Either an origin or a full /api/v1 URL works.
# The frontend appends /api/v1 when it is missing.
VITE_API_URL=http://localhost:8080/api/v1

# Optional. The WebSocket client currently derives this from VITE_API_URL,
# but you can set it explicitly for unusual proxies.
# VITE_WS_URL=ws://localhost:8080/api/v1/ws
