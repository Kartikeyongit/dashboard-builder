{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "cypress run --spec cypress/e2e/dashboard-smoke.cy.ts",
    "test:e2e:features": "cypress run --spec cypress/e2e/dashboard-features.cy.ts",
    "test:e2e:library": "cypress run --spec cypress/e2e/library.cy.ts",
    "test:e2e:builder": "cypress run --spec cypress/e2e/builder.cy.ts",
    "test:e2e:a11y": "cypress run --spec cypress/e2e/a11y.cy.ts",
    "test:e2e:landing": "cypress run --spec cypress/e2e/landing.cy.ts",
    "test:visual": "cypress run --spec cypress/e2e/visual.cy.ts",
    "visual:check": "node scripts/visual-regression.mjs",
    "visual:update": "npm run test:visual && node scripts/visual-regression.mjs --update",
    "budget": "node scripts/check-bundle-size.mjs",
    "og": "node scripts/generate-og.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@reduxjs/toolkit": "^2.12.0",
    "ag-grid-community": "^35.3.0",
    "ag-grid-react": "^35.3.0",
    "axios": "^1.16.1",
    "clsx": "^2.1.1",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "framer-motion": "^12.42.0",
    "lodash": "^4.18.1",
    "lucide-react": "^1.66.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-grid-layout": "^2.2.3",
    "react-loading-skeleton": "^3.5.0",
    "react-redux": "^9.3.0",
    "react-resizable": "^4.0.1",
    "react-router-dom": "^7.15.1",
    "sql-formatter": "^15.9.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.12.3",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-grid-layout": "^1.3.6",
    "@types/react-redux": "^7.1.34",
    "@vitejs/plugin-react": "^6.0.1",
    "axe-core": "^4.14.0",
    "cypress": "^15.15.0",
    "cypress-axe": "^1.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "monaco-editor": "^0.55.1",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12",
    "vitest": "^4.1.7"
  }
}
