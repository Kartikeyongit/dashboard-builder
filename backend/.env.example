# Copy this file to backend/.env and fill in real values.
# Never commit backend/.env.

# PostgreSQL connection string (Neon, Supabase, Render Postgres, or local Docker)
DB_URL=postgres://user:password@localhost:5432/dashboard_builder?sslmode=disable

# Redis connection string (Upstash free tier supports rediss://)
REDIS_URL=redis://localhost:6379

# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-characters

# Exactly 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-64-hex-characters

# Backend port
PORT=8080

# Public URL of the frontend. Used for CORS and generated share links.
# Local: http://localhost:5173
# Production: https://your-frontend.onrender.com
FRONTEND_URL=http://localhost:5173

# Optional: enables GET /api/v1/seed?token=... for one-time demo data.
# Leave empty to disable the endpoint.
SEED_SECRET=

# Optional: path to SQL migrations. The Docker image sets this automatically.
MIGRATIONS_DIR=
